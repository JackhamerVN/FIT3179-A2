{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Socio-Economic Advantage vs Academic Performance by State",
    "subtitle": "Relationship between average ICSEA and NAPLAN scores",
    "fontSize": 18,
    "fontWeight": 600,
    "anchor": "middle",
    "color": "#343a40",
    "offset": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#6c757d"
  },
  "width": 650,
  "height": 500,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true,
      "gridOpacity": 0.3,
      "gridColor": "#e0e0e0",
      "domainWidth": 1.5,
      "domainColor": "#666",
      "labelFont": "'Inter', system-ui, sans-serif",
      "titleFont": "'Inter', system-ui, sans-serif",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelFontSize": 11,
      "labelColor": "#495057",
      "titlePadding": 15
    },
    "legend": {
      "titleFont": "'Inter', system-ui, sans-serif",
      "labelFont": "'Inter', system-ui, sans-serif",
      "titleFontSize": 12,
      "labelFontSize": 11,
      "titleFontWeight": 600,
      "orient": "bottom",
      "columns": 2
    }
  },
  "params": [
    {
      "name": "year_level_filter",
      "value": "3",
      "bind": {
        "input": "select",
        "options": ["3", "5", "7", "9"],
        "labels": ["Year 3", "Year 5", "Year 7", "Year 9"],
        "name": "Select Year Level: "
      }
    },
    {
      "name": "domain_filter",
      "value": "Reading",
      "bind": {
        "input": "select",
        "options": ["Reading", "Writing", "Numeracy", "Spelling", "Grammar and punctuation"],
        "name": "Select NAPLAN Domain: "
      }
    }
  ],
  "datasets": {
    "state_icsea": [
      {"State": "NSW", "State_full": "New South Wales", "avg_ICSEA": 1003.5},
      {"State": "VIC", "State_full": "Victoria", "avg_ICSEA": 1006.2},
      {"State": "QLD", "State_full": "Queensland", "avg_ICSEA": 996.8},
      {"State": "SA", "State_full": "South Australia", "avg_ICSEA": 994.1},
      {"State": "WA", "State_full": "Western Australia", "avg_ICSEA": 1001.7},
      {"State": "TAS", "State_full": "Tasmania", "avg_ICSEA": 981.3},
      {"State": "NT", "State_full": "Northern Territory", "avg_ICSEA": 968.5},
      {"State": "ACT", "State_full": "Australian Capital Territory", "avg_ICSEA": 1048.9}
    ]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/NAPLAN%20national%20results%20dataset.csv"
  },
  "transform": [
    {
      "filter": "datum['Student attribute'] == 'All'"
    },
    {
      "filter": "datum.Subgroup == 'All'"
    },
    {
      "filter": "toString(datum['Year level']) == year_level_filter"
    },
    {
      "filter": "datum.Domain == domain_filter"
    },
    {
      "filter": "datum['State/territory'] != 'Australia'"
    },
    {
      "calculate": "toNumber(datum['Average NAPLAN score'])",
      "as": "NAPLAN_num"
    },
    {
      "filter": "isValid(datum.NAPLAN_num)"
    },
    {
      "aggregate": [
        {"op": "mean", "field": "NAPLAN_num", "as": "avg_NAPLAN"}
      ],
      "groupby": ["State/territory"]
    },
    {
      "calculate": "datum['State/territory'] == 'New South Wales' ? 'NSW' : datum['State/territory'] == 'Victoria' ? 'VIC' : datum['State/territory'] == 'Queensland' ? 'QLD' : datum['State/territory'] == 'South Australia' ? 'SA' : datum['State/territory'] == 'Western Australia' ? 'WA' : datum['State/territory'] == 'Tasmania' ? 'TAS' : datum['State/territory'] == 'Northern Territory' ? 'NT' : datum['State/territory'] == 'Australian Capital Territory' ? 'ACT' : datum['State/territory']",
      "as": "State"
    },
    {
      "lookup": "State",
      "from": {
        "data": {"name": "state_icsea"},
        "key": "State",
        "fields": ["avg_ICSEA", "State_full"]
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 400,
        "opacity": 0.8,
        "cursor": "pointer",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "avg_ICSEA",
          "type": "quantitative",
          "title": "Average ICSEA Score (Socio-Economic Advantage)",
          "scale": {"zero": false, "padding": 10}
        },
        "y": {
          "field": "avg_NAPLAN",
          "type": "quantitative",
          "title": "Average NAPLAN Score",
          "scale": {"zero": false, "padding": 10}
        },
        "color": {
          "field": "State/territory",
          "type": "nominal",
          "title": "State/Territory",
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "South Australia",
              "Western Australia",
              "Tasmania",
              "Northern Territory",
              "Australian Capital Territory"
            ],
            "range": [
              "#e74c3c",
              "#3498db",
              "#2ecc71",
              "#f39c12",
              "#9b59b6",
              "#1abc9c",
              "#e67e22",
              "#34495e"
            ]
          }
        },
        "tooltip": [
          {"field": "State/territory", "type": "nominal", "title": "State/Territory"},
          {"field": "State", "type": "nominal", "title": "Abbreviation"},
          {"field": "avg_ICSEA", "type": "quantitative", "title": "Average ICSEA", "format": ".1f"},
          {"field": "avg_NAPLAN", "type": "quantitative", "title": "Average NAPLAN Score", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "avg_ICSEA",
          "type": "quantitative"
        },
        "y": {
          "field": "avg_NAPLAN",
          "type": "quantitative"
        },
        "text": {
          "field": "State",
          "type": "nominal"
        },
        "color": {
          "value": "#2c3e50"
        }
      }
    }
  ]
}
