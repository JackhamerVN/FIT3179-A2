{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "padding": {
    "top": 8,
    "right": 8,
    "bottom": 8,
    "left": 8
  },
  "background": "transparent",
  "config": {
    "text": {
      "font": "B612, Arial, Helvetica, sans-serif",
      "fill": "#242B30"
    },
    "legend": {
      "labelFont": "B612, Arial, Helvetica, sans-serif",
      "titleFont": "B612, Arial, Helvetica, sans-serif",
      "labelFontSize": 12
    }
  },
  "usermeta": {
    "status": "webpage chart",
    "data_snapshot": "FY2025-26",
    "engine_test_target": "Vega 6.4.0",
    "chart_id": 11,
    "source": "Supplied BITRE workbook; FY2025-26"
  },
  "signals": [
    {
      "name": "width",
      "init": "max(containerSize()[0]-16, 280)",
      "on": [
        {
          "events": {
            "source": "window",
            "type": "resize"
          },
          "update": "max(containerSize()[0]-16, 280)"
        }
      ]
    },
    {
      "name": "height",
      "value": 350
    },
    {
      "name": "selectedState",
      "value": "",
      "on": [
        {
          "events": "click",
          "update": "datum && datum.state_id && datum.state_id!==selectedState ? datum.state_id : ''"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "au",
      "type": "conicEqualArea",
      "rotate": [
        -134,
        0,
        0
      ],
      "center": [
        0,
        -27
      ],
      "parallels": [
        -18,
        -36
      ],
      "fit": {
        "signal": "{'type':'FeatureCollection','features':data('geometry')}"
      },
      "extent": {
        "signal": "[[42,12],[width-65,height-85]]"
      }
    }
  ],
  "data": [
    {
      "name": "geometry",
      "url": "data/states-geometry.json"
    },
    {
      "name": "states",
      "url": "data/states-summary.json",
      "transform": [
        {
          "type": "geopoint",
          "projection": "au",
          "fields": [
            "anchor_lon",
            "anchor_lat"
          ],
          "as": [
            "anchor_x",
            "anchor_y"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "size",
      "type": "linear",
      "domain": [
        0,
        30632770
      ],
      "range": [
        0,
        {
          "signal": "4*pow(min(width,height)*.145,2)"
        }
      ],
      "zero": true
    },
    {
      "name": "change",
      "type": "threshold",
      "domain": [
        -10,
        0,
        10
      ],
      "range": [
        "#B55732",
        "#E6BFAE",
        "#B9CFE6",
        "#316EAC"
      ]
    }
  ],
  "marks": [
    {
      "name": "circles",
      "type": "symbol",
      "from": {
        "data": "states"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "anchor_x"
          },
          "y": {
            "field": "anchor_y"
          }
        },
        "update": {
          "size": {
            "scale": "size",
            "field": "latest_comparable"
          },
          "fill": {
            "scale": "change",
            "field": "change_pct"
          },
          "fillOpacity": {
            "signal": "selectedState==='' || datum.state_id===selectedState ? 1 : .25"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2
          },
          "tooltip": {
            "signal": "{'State':datum.name,'Airport passengers, 2025-26':format(datum.latest_comparable,',d'),'Change since 2018-19':format(datum.change_pct,'+.1f')+'%','Routes':'57 comparable routes'}"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      },
      "transform": [
        {
          "type": "force",
          "static": true,
          "iterations": 600,
          "forces": [
            {
              "force": "x",
              "x": "datum.anchor_x",
              "strength": 0.1
            },
            {
              "force": "y",
              "y": "datum.anchor_y",
              "strength": 0.1
            },
            {
              "force": "collide",
              "radius": {
                "expr": "sqrt(datum.size)/2+4"
              },
              "iterations": 6
            }
          ]
        }
      ]
    },
    {
      "name": "stateLabels",
      "type": "text",
      "from": {
        "data": "circles"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "field": "datum.state_id"
          },
          "fill": {
            "signal": "sqrt(datum.size)/2<16 || abs(datum.datum.change_pct)<10 ? '#243637' : 'white'"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "dx": {
            "signal": "sqrt(datum.size)/2<16 ? (datum.datum.state_id==='NT' ? -1 : 1)*(sqrt(datum.size)/2+5) : 0"
          },
          "align": {
            "signal": "sqrt(datum.size)/2<16 ? (datum.datum.state_id==='NT' ? 'right' : 'left') : 'center'"
          },
          "baseline": {
            "value": "middle"
          },
          "fillOpacity": {
            "signal": "selectedState==='' || datum.datum.state_id===selectedState ? 1 : .35"
          }
        }
      }
    }
  ],
  "legends": [
    {
      "size": "size",
      "title": "Airport passengers",
      "orient": "bottom-left",
      "values": [
        5000000,
        20000000
      ],
      "format": ".2s",
      "symbolFillColor": "#C9D3D2",
      "symbolStrokeColor": "white",
      "labelFont": "B612, Arial, Helvetica, sans-serif",
      "titleFont": "B612, Arial, Helvetica, sans-serif"
    }
  ],
  "description": "Airport passengers by state on the 57 comparable routes in FY2025-26 (circle area) and their change since FY2018-19 (colour)."
}
