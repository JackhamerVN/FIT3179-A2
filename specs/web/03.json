{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Percentage change from FY2018-19 to FY2025-26 in resident population, domestic passenger trips and seats flown.",
  "width": "container",
  "height": 260,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/national-monthly.json"
  },
  "transform": [
    {
      "calculate": "utcmonth(toDate(datum.month))>=6 ? utcyear(toDate(datum.month))+1 : utcyear(toDate(datum.month))",
      "as": "year_ending"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "passenger_trips",
          "as": "passenger_trips"
        },
        {
          "op": "sum",
          "field": "seats",
          "as": "seats"
        }
      ],
      "groupby": [
        "year_ending"
      ]
    },
    {
      "lookup": "year_ending",
      "from": {
        "data": {
          "url": "data/trips-per-resident.json"
        },
        "key": "year_ending",
        "fields": [
          "fy",
          "population"
        ]
      }
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.population : null",
      "as": "population_2019"
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.passenger_trips : null",
      "as": "passenger_trips_2019"
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.seats : null",
      "as": "seats_2019"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "population_2019",
          "as": "population_base"
        },
        {
          "op": "max",
          "field": "passenger_trips_2019",
          "as": "passenger_trips_base"
        },
        {
          "op": "max",
          "field": "seats_2019",
          "as": "seats_base"
        }
      ]
    },
    {
      "calculate": "100*(datum.population/datum.population_base-1)",
      "as": "Resident population"
    },
    {
      "calculate": "100*(datum.passenger_trips/datum.passenger_trips_base-1)",
      "as": "Passenger trips"
    },
    {
      "calculate": "100*(datum.seats/datum.seats_base-1)",
      "as": "Seats flown"
    },
    {
      "fold": [
        "Resident population",
        "Passenger trips",
        "Seats flown"
      ],
      "as": [
        "measure",
        "index"
      ]
    },
    {
      "filter": "datum.year_ending===2026"
    },
    {
      "calculate": "(datum.index>0 ? '+' : '\u2212')+format(abs(datum.index),'.1f')+'%'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 38,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "y": {
          "field": "measure",
          "type": "nominal",
          "sort": [
            "Resident population",
            "Passenger trips",
            "Seats flown"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelColor": "#243637",
            "ticks": false,
            "domain": false,
            "labelPadding": 10,
            "labelExpr": "datum.value==='Resident population' ? 'Residents' : datum.value"
          }
        },
        "x": {
          "field": "index",
          "type": "quantitative",
          "scale": {
            "domain": [
              -10,
              14
            ],
            "nice": false
          },
          "axis": {
            "title": "Change, 2018\u201319 to 2025\u201326 (%)",
            "values": [
              -10,
              -5,
              0,
              5,
              10
            ],
            "labelExpr": "(datum.value>0 ? '+' : '')+replace(datum.label,'-','\u2212')+'%'"
          }
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Resident population",
              "Passenger trips",
              "Seats flown"
            ],
            "range": [
              "#7C8C8E",
              "#177A88",
              "#243637"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "measure",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "index",
            "type": "quantitative",
            "title": "Change since 2018-19 (%)",
            "format": "+.1f"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Residents at 31 December 2025",
            "format": ",.0f"
          },
          {
            "field": "passenger_trips",
            "type": "quantitative",
            "title": "Passenger trips, 2025-26",
            "format": ",.0f"
          },
          {
            "field": "seats",
            "type": "quantitative",
            "title": "Seats flown, 2025-26",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#243637",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "lineHeight": 15,
        "color": "#243637",
        "fontWeight": "bold",
        "align": "left",
        "baseline": "middle",
        "dx": 7
      },
      "encoding": {
        "y": {
          "field": "measure",
          "type": "nominal",
          "sort": [
            "Resident population",
            "Passenger trips",
            "Seats flown"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelColor": "#243637",
            "ticks": false,
            "domain": false,
            "labelPadding": 10,
            "labelExpr": "datum.value==='Resident population' ? 'Residents' : datum.value"
          }
        },
        "x": {
          "field": "index",
          "type": "quantitative",
          "scale": {
            "domain": [
              -10,
              14
            ],
            "nice": false
          },
          "axis": {
            "title": "Change, 2018\u201319 to 2025\u201326 (%)",
            "values": [
              -10,
              -5,
              0,
              5,
              10
            ],
            "labelExpr": "(datum.value>0 ? '+' : '')+replace(datum.label,'-','\u2212')+'%'"
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Resident population",
              "Passenger trips",
              "Seats flown"
            ],
            "range": [
              "#7C8C8E",
              "#177A88",
              "#243637"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "datum.index>=0",
            "value": 1
          },
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "lineHeight": 15,
        "color": "#243637",
        "fontWeight": "bold",
        "align": "right",
        "baseline": "middle",
        "dx": -7
      },
      "encoding": {
        "y": {
          "field": "measure",
          "type": "nominal",
          "sort": [
            "Resident population",
            "Passenger trips",
            "Seats flown"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelColor": "#243637",
            "ticks": false,
            "domain": false,
            "labelPadding": 10,
            "labelExpr": "datum.value==='Resident population' ? 'Residents' : datum.value"
          }
        },
        "x": {
          "field": "index",
          "type": "quantitative",
          "scale": {
            "domain": [
              -10,
              14
            ],
            "nice": false
          },
          "axis": {
            "title": "Change, 2018\u201319 to 2025\u201326 (%)",
            "values": [
              -10,
              -5,
              0,
              5,
              10
            ],
            "labelExpr": "(datum.value>0 ? '+' : '')+replace(datum.label,'-','\u2212')+'%'"
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Resident population",
              "Passenger trips",
              "Seats flown"
            ],
            "range": [
              "#7C8C8E",
              "#177A88",
              "#243637"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "datum.index<0",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],
  "usermeta": {
    "chart_id": 3,
    "source": "BITRE workbook and ABS National, state and territory population, March 2026"
  }
}
