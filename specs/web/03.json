{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Resident population, domestic passenger trips and seats flown, indexed to 100 in FY2018-19.",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/national-monthly.json"
  },
  "transform": [
    {
      "calculate": "utcmonth(toDate(datum.month))>=6 ? utcyear(toDate(datum.month))+1 : utcyear(toDate(datum.month))",
      "as": "year_ending"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "passenger_trips",
          "as": "passenger_trips"
        },
        {
          "op": "sum",
          "field": "seats",
          "as": "seats"
        }
      ],
      "groupby": [
        "year_ending"
      ]
    },
    {
      "lookup": "year_ending",
      "from": {
        "data": {
          "url": "data/trips-per-resident.json"
        },
        "key": "year_ending",
        "fields": [
          "fy",
          "population"
        ]
      }
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.population : null",
      "as": "population_2019"
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.passenger_trips : null",
      "as": "passenger_trips_2019"
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.seats : null",
      "as": "seats_2019"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "population_2019",
          "as": "population_base"
        },
        {
          "op": "max",
          "field": "passenger_trips_2019",
          "as": "passenger_trips_base"
        },
        {
          "op": "max",
          "field": "seats_2019",
          "as": "seats_base"
        }
      ]
    },
    {
      "calculate": "100*datum.population/datum.population_base",
      "as": "Resident population"
    },
    {
      "calculate": "100*datum.passenger_trips/datum.passenger_trips_base",
      "as": "Passenger trips"
    },
    {
      "calculate": "100*datum.seats/datum.seats_base",
      "as": "Seats flown"
    },
    {
      "fold": [
        "Resident population",
        "Passenger trips",
        "Seats flown"
      ],
      "as": [
        "measure",
        "index"
      ]
    },
    {
      "calculate": "datum.measure==='Resident population' ? (width<550 ? 'People' : 'Resident population') : datum.measure==='Passenger trips' ? (width<550 ? 'Trips' : 'Passenger trips') : datum.measure==='Seats flown' ? (width<550 ? 'Seats' : 'Seats flown') : ''",
      "as": "name"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "start": "2019-20",
            "end": "2021-22"
