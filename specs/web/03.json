{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Resident population, domestic passenger trips and seats flown, indexed to 100 in FY2018-19.",
  "autosize": {
    "type": "pad"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/national-monthly.json"
  },
  "transform": [
    {
      "calculate": "utcmonth(toDate(datum.month))>=6 ? utcyear(toDate(datum.month))+1 : utcyear(toDate(datum.month))",
      "as": "year_ending"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "passenger_trips",
          "as": "passenger_trips"
        },
        {
          "op": "sum",
          "field": "seats",
          "as": "seats"
        }
      ],
      "groupby": [
        "year_ending"
      ]
    },
    {
      "lookup": "year_ending",
      "from": {
        "data": {
          "url": "data/trips-per-resident.json"
        },
        "key": "year_ending",
        "fields": [
          "fy",
          "population"
        ]
      }
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.population : null",
      "as": "population_2019"
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.passenger_trips : null",
      "as": "passenger_trips_2019"
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.seats : null",
      "as": "seats_2019"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "population_2019",
          "as": "population_base"
        },
        {
          "op": "max",
          "field": "passenger_trips_2019",
          "as": "passenger_trips_base"
        },
        {
          "op": "max",
          "field": "seats_2019",
          "as": "seats_base"
        }
      ]
    },
    {
      "calculate": "100*datum.population/datum.population_base",
      "as": "Resident population"
    },
    {
      "calculate": "100*datum.passenger_trips/datum.passenger_trips_base",
      "as": "Passenger trips"
    },
    {
      "calculate": "100*datum.seats/datum.seats_base",
      "as": "Seats flown"
    },
    {
      "fold": [
        "Resident population",
        "Passenger trips",
        "Seats flown"
      ],
      "as": [
        "measure",
        "index"
      ]
    },
    {
      "calculate": "datum.year_ending<=2019 ? 'before' : datum.year_ending>=2023 ? 'after' : 'omitted'",
      "as": "period"
    }
  ],
  "facet": {
    "column": {
      "field": "measure",
      "type": "nominal",
      "sort": [
        "Resident population",
        "Passenger trips",
        "Seats flown"
      ],
      "header": {
        "title": null,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelColor": "#243637",
        "labelFont": "B612, Arial, Helvetica, sans-serif",
        "labelExpr": "datum.value==='Resident population' ? 'Residents' : datum.value"
      }
    }
  },
  "spacing": 20,
  "spec": {
    "width": 98,
    "height": 240,
    "layer": [
      {
        "transform": [
          {
            "filter": "datum.year_ending===2021"
          },
          {
            "calculate": "'2019-20'",
            "as": "start"
          },
          {
            "calculate": "'2021-22'",
            "as": "end"
          }
        ],
        "mark": {
          "type": "rect",
          "color": "#E4ECEA",
          "opacity": 0.75
        },
        "encoding": {
          "x": {
            "field": "start",
            "type": "ordinal",
            "scale": {
              "type": "point",
              "domain": [
                "2014-15",
                "2015-16",
                "2016-17",
                "2017-18",
                "2018-19",
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23",
                "2023-24",
                "2024-25",
                "2025-26"
              ],
              "padding": 0.3
            },
            "axis": {
              "title": null,
              "labelAngle": 0,
              "values": [
                "2014-15",
                "2025-26"
              ],
              "grid": false,
              "labelFontSize": 11,
              "labelAlign": {
                "condition": [
                  {
                    "test": "datum.value==='2014-15'",
                    "value": "left"
                  },
                  {
                    "test": "datum.value==='2025-26'",
                    "value": "right"
                  }
                ],
                "value": "center"
              },
              "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
            }
          },
          "x2": {
            "field": "end"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year_ending===2021"
          }
        ],
        "mark": {
          "type": "rule",
          "strokeDash": [
            2,
            3
          ],
          "color": "#9AAAA8"
        },
        "encoding": {
          "y": {
            "datum": 100
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year_ending===2019 || datum.year_ending===2023"
          }
        ],
        "mark": {
          "type": "line",
          "strokeWidth": 1.5,
          "strokeDash": [
            3,
            4
          ],
          "opacity": 0.7
        },
        "encoding": {
          "x": {
            "field": "fy",
            "type": "ordinal",
            "scale": {
              "type": "point",
              "domain": [
                "2014-15",
                "2015-16",
                "2016-17",
                "2017-18",
                "2018-19",
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23",
                "2023-24",
                "2024-25",
                "2025-26"
              ],
              "padding": 0.3
            },
            "axis": {
              "title": null,
              "labelAngle": 0,
              "values": [
                "2014-15",
                "2025-26"
              ],
              "grid": false,
              "labelFontSize": 11,
              "labelAlign": {
                "condition": [
                  {
                    "test": "datum.value==='2014-15'",
                    "value": "left"
                  },
                  {
                    "test": "datum.value==='2025-26'",
                    "value": "right"
                  }
                ],
                "value": "center"
              },
              "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
            }
          },
          "y": {
            "field": "index",
            "type": "quantitative",
            "scale": {
              "domain": [
                88,
                114
              ],
              "nice": false,
              "zero": false
            },
            "axis": {
              "title": "Index (2018\u201319 = 100)",
              "values": [
                90,
                100,
                110
              ]
            }
          },
          "color": {
            "field": "measure",
            "type": "nominal",
            "scale": {
              "domain": [
                "Resident population",
                "Passenger trips",
                "Seats flown"
