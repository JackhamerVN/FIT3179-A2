{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "padding": {
    "top": 8,
    "right": 8,
    "bottom": 8,
    "left": 8
  },
  "background": "transparent",
  "config": {
    "text": {
      "font": "B612, Arial, Helvetica, sans-serif",
      "fill": "#242B30"
    },
    "legend": {
      "labelFont": "B612, Arial, Helvetica, sans-serif",
      "titleFont": "B612, Arial, Helvetica, sans-serif",
      "labelFontSize": 12
    }
  },
  "usermeta": {
    "status": "webpage chart",
    "data_snapshot": "FY2025-26",
    "engine_test_target": "Vega 6.4.0",
    "chart_id": 10,
    "source": "Supplied BITRE workbook; FY2025-26"
  },
  "signals": [
    {
      "name": "width",
      "init": "max(containerSize()[0]-16, 280)",
      "on": [
        {
          "events": {
            "source": "window",
            "type": "resize"
          },
          "update": "max(containerSize()[0]-16, 280)"
        }
      ]
    },
    {
      "name": "height",
      "value": 370
    },
    {
      "name": "selectedGroup",
      "value": "",
      "bind": {
        "input": "select",
        "name": "Highlight route group ",
        "options": [
          "",
          "0-0",
          "0-1",
          "0-2",
          "1-0",
          "1-1",
          "1-2"
        ],
        "labels": [
          "All route groups",
          "Between states / <500 km",
          "Between states / 500-1,499 km",
          "Between states / 1,500+ km",
          "Within a state / <500 km",
          "Within a state / 500-1,499 km",
          "Within a state / 1,500+ km"
        ]
      },
      "on": [
        {
          "events": "@ribbons:click",
          "update": "datum.group_id===selectedGroup ? '' : datum.group_id"
        }
      ]
    },
    {
      "name": "gap",
      "value": 20
    },
    {
      "name": "sourceX",
      "update": "width<500 ? 94 : 156"
    },
    {
      "name": "targetX",
      "update": "width-122"
    },
    {
      "name": "headerHeight",
      "value": 32
    }
  ],
  "scales": [
    {
      "name": "flow",
      "type": "linear",
      "domain": [
        0,
        53982647
      ],
      "range": [
        0,
        {
          "signal": "height-headerHeight-2*gap"
        }
      ],
      "zero": true
    },
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Between states",
        "Within a state"
      ],
      "range": [
        "#177A88",
        "#86949B"
      ]
    }
  ],
  "data": [
    {
      "name": "flows",
      "url": "data/route-groups.json",
      "transform": [
        {
          "type": "stack",
          "field": "passenger_trips",
          "sort": {
            "field": [
              "left_order",
              "right_order"
            ],
            "order": [
              "ascending",
              "ascending"
            ]
          },
          "as": [
            "s0",
            "s1"
          ]
        },
        {
          "type": "stack",
          "field": "passenger_trips",
          "sort": {
            "field": [
              "right_order",
              "left_order"
            ],
            "order": [
              "ascending",
              "ascending"
            ]
          },
          "as": [
            "t0",
            "t1"
          ]
        },
        {
          "type": "formula",
          "as": "sy0",
          "expr": "scale('flow',datum.s0)+datum.left_order*gap+gap/2+headerHeight"
        },
        {
          "type": "formula",
          "as": "sy1",
          "expr": "scale('flow',datum.s1)+datum.left_order*gap+gap/2+headerHeight"
        },
        {
          "type": "formula",
          "as": "ty0",
          "expr": "scale('flow',datum.t0)+datum.right_order*gap+headerHeight"
        },
        {
          "type": "formula",
          "as": "ty1",
          "expr": "scale('flow',datum.t1)+datum.right_order*gap+headerHeight"
        },
        {
          "type": "formula",
          "as": "ribbon",
          "expr": "'M'+(sourceX+7)+','+datum.sy0+' C'+(sourceX+(targetX-sourceX)*.45)+','+datum.sy0+' '+(sourceX+(targetX-sourceX)*.55)+','+datum.ty0+' '+targetX+','+datum.ty0+' L'+targetX+','+datum.ty1+' C'+(sourceX+(targetX-sourceX)*.55)+','+datum.ty1+' '+(sourceX+(targetX-sourceX)*.45)+','+datum.sy1+' '+(sourceX+7)+','+datum.sy1+' Z'"
        }
      ]
    },
    {
      "name": "leftNodes",
      "source": "flows",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "relation"
          ],
          "fields": [
            "sy0",
            "sy1",
            "passenger_trips"
          ],
          "ops": [
            "min",
            "max",
            "sum"
          ],
          "as": [
            "y0",
            "y1",
            "passenger_trips"
          ]
        }
      ]
    },
    {
      "name": "rightNodes",
      "source": "flows",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "distance_band"
          ],
          "fields": [
            "ty0",
            "ty1",
            "passenger_trips"
          ],
          "ops": [
            "min",
            "max",
            "sum"
          ],
          "as": [
            "y0",
            "y1",
            "passenger_trips"
          ]
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "ribbons",
      "type": "path",
      "from": {
        "data": "flows"
      },
      "encode": {
        "update": {
          "path": {
            "field": "ribbon"
          },
          "fill": {
            "scale": "colour",
            "field": "relation"
          },
          "fillOpacity": {
            "signal": "selectedGroup==='' || datum.group_id===selectedGroup ? .72 : .12"
          },
          "tooltip": {
            "signal": "{'Group':datum.relation,'Distance':datum.distance_band,'Passenger trips':format(datum.passenger_trips,',d'),'Routes':length(datum.route_ids)}"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leftNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "sourceX"
          },
          "width": {
            "value": 7
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#242B30"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leftNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "sourceX"
          },
          "dx": {
            "value": -9
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2"
          },
          "dy": {
            "value": -11
          },
          "text": {
            "signal": "datum.relation==='Between states' ? ['Between states','or territories'] : ['Within one state','or territory']"
          },
          "lineHeight": {
            "value": 14
          },
          "fontSize": {
            "signal": "width<500 ? 11 : 12"
          },
          "align": {
            "value": "right"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leftNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "sourceX"
          },
          "dx": {
            "value": -9
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2"
          },
          "dy": {
            "value": 23
          },
          "text": {
            "signal": "format(datum.passenger_trips/1e6,'.2f')+'m trips'"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#64727A"
          },
          "align": {
            "value": "right"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "rightNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "targetX"
          },
          "width": {
            "value": 7
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#242B30"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "rightNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "targetX"
          },
          "dx": {
            "value": 16
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2"
          },
          "dy": {
            "signal": "width<500 && 'rightNodes'==='leftNodes' ? -9 : -3"
          },
          "text": {
            "field": "distance_band"
          },
          "lineHeight": {
            "value": 14
          },
          "fontSize": {
            "value": 12
          },
          "align": {
            "value": "left"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "rightNodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "targetX"
          },
          "dx": {
            "value": 16
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2"
          },
          "dy": {
            "signal": "width<500 && 'rightNodes'==='leftNodes' ? 24 : 13"
          },
          "text": {
            "signal": "format(datum.passenger_trips/1e6,'.2f')+'m trips'"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#64727A"
          },
          "align": {
            "value": "left"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "sourceX"
          },
          "dx": {
            "value": -9
          },
          "y": {
            "value": 0
          },
          "text": {
            "value": "State / territory"
          },
          "baseline": {
            "value": "top"
          },
          "align": {
            "value": "right"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#506365"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "targetX"
          },
          "dx": {
            "value": 16
          },
          "y": {
            "value": 0
          },
          "text": {
            "value": "Route distance"
          },
          "baseline": {
            "value": "top"
          },
          "align": {
            "value": "left"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#506365"
          }
        }
      }
    }
  ],
  "description": "The same passenger trips classified by state or territory link and route distance; city pairs combine both directions."
}
