{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Twelve largest absolute route changes among 57 comparable pairs; rank depends on the selected measure.",
  "width": 500,
  "height": 425,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/routes-comparison.json"
  },
  "params": [
    {
      "name": "changeMode",
      "value": "percent"
    }
  ],
  "transform": [
    {
      "calculate": "changeMode==='percent' ? datum.change_pct : datum.delta_trips",
      "as": "change"
    },
    {
      "calculate": "abs(datum.change)",
      "as": "magnitude"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "magnitude",
          "order": "descending"
        },
        {
          "field": "route_id",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.rank<=12"
    },
    {
      "calculate": "replace(changeMode==='percent' ? format(datum.change,'+.1f')+'%' : format(datum.change,'+,.0f'),'-','\u2212')",
      "as": "value_label"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "position"
        }
      ],
      "sort": [
        {
          "field": "change",
          "order": "descending"
        }
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "route_name",
      "type": "nominal",
      "sort": {
        "field": "position",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelLimit": 200,
        "labelFontSize": 12
      }
    },
    "x": {
      "field": "change",
      "type": "quantitative",
      "scale": {
        "zero": true,
        "padding": 52
      },
      "axis": {
        "title": "Change (%)",
        "format": "~s",
        "tickCount": 5
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 16,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.change>=0",
            "value": "#316EAC"
          },
          "value": "#B55732"
        },
        "tooltip": [
          {
            "field": "route_name",
            "type": "nominal",
            "title": "Route"
          },
          {
            "field": "baseline_trips",
            "type": "quantitative",
            "title": "FY2018-19 trips",
            "format": ",.0f"
          },
          {
            "field": "latest_trips",
            "type": "quantitative",
            "title": "FY2025-26 trips",
            "format": ",.0f"
          },
          {
            "field": "change_pct",
            "type": "quantitative",
            "title": "Change (%)",
            "format": "+.1f"
          },
          {
            "field": "delta_trips",
            "type": "quantitative",
            "title": "Change in trips",
            "format": "+,.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#243637",
        "align": "left",
        "baseline": "middle",
        "dx": 5
      },
      "encoding": {
        "text": {
          "field": "value_label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "test": "datum.change>=0",
            "value": 1
          },
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#243637",
        "align": "right",
        "baseline": "middle",
        "dx": -5
      },
      "encoding": {
        "text": {
          "field": "value_label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "test": "datum.change<0",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],
  "usermeta": {
    "chart_id": 9,
    "source": "Supplied BITRE workbook; FY2025-26"
  }
}
