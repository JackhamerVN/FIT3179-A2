{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Route distance and percentage change in passenger trips for 57 comparable city pairs.",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/routes-comparison.json"
  },
  "transform": [
    {
      "calculate": "replace(datum.route_name,' - ','\u2013')",
      "as": "label"
    },
    {
      "calculate": "datum.change_pct>=0 ? 'More trips' : 'Fewer trips'",
      "as": "direction"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "from": 0,
            "to": 500
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#F3E4DC",
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "from",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4000
            ]
          },
          "axis": {
            "title": "Route distance (km)",
            "tickCount": 4,
            "format": ",.0f"
          }
        },
        "x2": {
          "field": "to"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "from": 0,
            "to": 500
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#B55732",
        "align": "left",
        "baseline": "top",
        "dx": 4,
        "fontWeight": "bold",
        "y": 4,
        "text": [
          "Under 500 km:",
          "12 of 13 fell"
        ]
      },
      "encoding": {
        "x": {
          "field": "from",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4000
            ]
          },
          "axis": {
            "title": "Route distance (km)",
            "tickCount": 4,
            "format": ",.0f"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#809492"
      },
      "encoding": {
        "y": {
          "datum": 0
        }
      }
    },
    {
      "params": [
        {
          "name": "pickedRoute",
          "select": {
            "type": "point",
            "fields": [
              "route_id"
            ],
            "on": "click",
            "clear": "dblclick"
          },
          "bind": {
            "input": "select",
            "options": [
              null,
              "ADL-ASP",
              "ADL-BNE",
              "ADL-CBR",
              "ADL-OOL",
              "ADL-MEL",
              "ADL-PER",
              "ADL-PLO",
              "ADL-SYD",
              "ABX-SYD",
              "BNK-SYD",
              "BDB-BNE",
              "BNE-CNS",
              "BNE-CBR",
              "BNE-DRW",
              "BNE-EMD",
              "BNE-GLT",
              "BNE-HTI",
              "BNE-HBA",
              "BNE-MKY",
              "BNE-MEL",
              "BNE-ISA",
              "BNE-NTL",
              "BNE-PER",
              "BNE-PPP",
              "BNE-ROK",
              "BNE-SYD",
              "BNE-TSV",
              "BME-PER",
              "CNS-MEL",
              "CNS-SYD",
              "CBR-MEL",
              "CBR-SYD",
              "CFS-SYD",
              "DRW-MEL",
              "DRW-PER",
              "DBO-SYD",
              "GET-PER",
              "MEL-OOL",
              "OOL-SYD",
              "HTI-SYD",
              "HBA-MEL",
              "HBA-SYD",
              "KGI-PER",
              "KTA-PER",
              "LST-MEL",
              "LST-SYD",
              "MEL-MQL",
              "MEL-NTL",
              "MEL-PER",
              "MCY-MEL",
              "MEL-SYD",
              "PER-ZNE",
              "PER-PHE",
              "PER-SYD",
              "PQQ-SYD",
              "MCY-SYD",
              "SYD-WGA"
            ],
            "labels": [
              "All 57 routes",
              "Adelaide \u2013 Alice Springs",
              "Adelaide \u2013 Brisbane",
              "Adelaide \u2013 Canberra",
              "Adelaide \u2013 Gold Coast",
              "Adelaide \u2013 Melbourne",
              "Adelaide \u2013 Perth",
              "Adelaide \u2013 Port Lincoln",
              "Adelaide \u2013 Sydney",
              "Albury \u2013 Sydney",
              "Ballina \u2013 Sydney",
              "Brisbane \u2013 Bundaberg",
              "Brisbane \u2013 Cairns",
              "Brisbane \u2013 Canberra",
              "Brisbane \u2013 Darwin",
              "Brisbane \u2013 Emerald",
              "Brisbane \u2013 Gladstone",
              "Brisbane \u2013 Hamilton Island",
              "Brisbane \u2013 Hobart",
              "Brisbane \u2013 Mackay",
              "Brisbane \u2013 Melbourne",
              "Brisbane \u2013 Mount Isa",
              "Brisbane \u2013 Newcastle",
              "Brisbane \u2013 Perth",
              "Brisbane \u2013 Proserpine",
              "Brisbane \u2013 Rockhampton",
              "Brisbane \u2013 Sydney",
              "Brisbane \u2013 Townsville",
              "Broome \u2013 Perth",
              "Cairns \u2013 Melbourne",
              "Cairns \u2013 Sydney",
              "Canberra \u2013 Melbourne",
              "Canberra \u2013 Sydney",
              "Coffs Harbour \u2013 Sydney",
              "Darwin \u2013 Melbourne",
              "Darwin \u2013 Perth",
              "Dubbo \u2013 Sydney",
              "Geraldton \u2013 Perth",
              "Gold Coast \u2013 Melbourne",
              "Gold Coast \u2013 Sydney",
              "Hamilton Island \u2013 Sydney",
              "Hobart \u2013 Melbourne",
              "Hobart \u2013 Sydney",
              "Kalgoorlie \u2013 Perth",
              "Karratha \u2013 Perth",
              "Launceston \u2013 Melbourne",
              "Launceston \u2013 Sydney",
              "Melbourne \u2013 Mildura",
              "Melbourne \u2013 Newcastle",
              "Melbourne \u2013 Perth",
              "Melbourne \u2013 Sunshine Coast",
              "Melbourne \u2013 Sydney",
              "Newman \u2013 Perth",
              "Perth \u2013 Port Hedland",
              "Perth \u2013 Sydney",
              "Port Macquarie \u2013 Sydney",
              "Sunshine Coast \u2013 Sydney",
              "Sydney \u2013 Wagga Wagga"
            ],
            "name": "Find a route "
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 65,
        "stroke": "white",
        "strokeWidth": 0.6,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "distance_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4000
            ]
          },
          "axis": {
            "title": "Route distance (km)",
            "tickCount": 4,
            "format": ",.0f"
          }
        },
        "y": {
          "field": "change_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              -45,
              75
            ]
          },
          "axis": {
            "title": "Change in trips, 2018\u201319 to 2025\u201326 (%)",
            "tickCount": 5
          }
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "More trips",
              "Fewer trips"
            ],
            "range": [
              "#316EAC",
              "#B55732"
            ]
          },
          "legend": {
            "title": "Since 2018\u201319",
            "orient": "top-right",
            "symbolType": "circle"
          }
        },
        "size": {
          "condition": {
            "param": "pickedRoute",
            "empty": false,
            "value": 160
          },
          "value": 65
        },
        "opacity": {
          "condition": {
            "param": "pickedRoute",
            "empty": true,
            "value": 0.8
          },
          "value": 0.12
        },
        "tooltip": [
          {
            "field": "route_name",
            "type": "nominal",
            "title": "Route"
          },
          {
            "field": "distance_km",
            "type": "quantitative",
            "title": "Distance (km)",
            "format": ",.0f"
          },
          {
            "field": "change_pct",
            "type": "quantitative",
            "title": "Change (%)",
            "format": "+.1f"
          },
          {
            "field": "baseline_trips",
            "type": "quantitative",
            "title": "FY2018-19 trips",
            "format": ",.0f"
          },
          {
            "field": "latest_trips",
            "type": "quantitative",
            "title": "FY2025-26 trips",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "route_id",
            "oneOf": [
              "KTA-PER",
              "CFS-SYD",
              "ADL-ASP"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#243637",
        "baseline": "middle",
        "align": "left",
        "dx": 8
      },
      "encoding": {
        "x": {
          "field": "distance_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4000
            ]
          },
          "axis": {
            "title": "Route distance (km)",
            "tickCount": 4,
            "format": ",.0f"
          }
        },
        "y": {
          "field": "change_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              -45,
              75
            ]
          },
          "axis": {
            "title": "Change in trips, 2018\u201319 to 2025\u201326 (%)",
            "tickCount": 5
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "pickedRoute",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "route_id",
            "oneOf": [
              "BNE-PER"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#243637",
        "baseline": "middle",
        "align": "right",
        "dx": -8
      },
      "encoding": {
        "x": {
          "field": "distance_km",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4000
            ]
          },
          "axis": {
            "title": "Route distance (km)",
            "tickCount": 4,
            "format": ",.0f"
          }
        },
        "y": {
          "field": "change_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              -45,
              75
            ]
          },
          "axis": {
            "title": "Change in trips, 2018\u201319 to 2025\u201326 (%)",
            "tickCount": 5
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "pickedRoute",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      }
    }
  ],
  "usermeta": {
    "chart_id": 9,
    "source": "Supplied BITRE workbook; FY2018-19 and FY2025-26"
  }
}
