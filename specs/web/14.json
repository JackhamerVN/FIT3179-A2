{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Domestic passenger trips and Australia's resident population, indexed to 100 in FY2018-19.",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/trips-per-resident.json"
  },
  "transform": [
    {
      "calculate": "datum.year_ending===2019 ? datum.passenger_trips : null",
      "as": "base_trips"
    },
    {
      "calculate": "datum.year_ending===2019 ? datum.population : null",
      "as": "base_population"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "base_trips",
          "as": "trips_2019"
        },
        {
          "op": "max",
          "field": "base_population",
          "as": "population_2019"
        }
      ]
    },
    {
      "calculate": "100*datum.passenger_trips/datum.trips_2019",
      "as": "Passenger trips"
    },
    {
      "calculate": "100*datum.population/datum.population_2019",
      "as": "Resident population"
    },
    {
      "fold": [
        "Passenger trips",
        "Resident population"
      ],
      "as": [
        "measure",
        "index"
      ]
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "start": "2019-20",
            "end": "2021-22"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#E4ECEA",
        "opacity": 0.75
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "10"
              },
              {
                "expr": "width-(width<550 ? 64 : 150)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
            "labelAngle": 0,
            "labelOverlap": "parity",
            "grid": false,
            "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
          }
        },
        "x2": {
          "field": "end"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "fy": "2020-21",
            "note": [
              "Travel bans",
              "and lockdowns"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#506365",
        "baseline": "bottom"
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "10"
              },
              {
                "expr": "width-(width<550 ? 64 : 150)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
