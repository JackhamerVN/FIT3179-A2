{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Share of seats filled on the 15 busiest comparable routes, FY2018-19 and FY2025-26.",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/route-occupancy.json"
  },
  "transform": [
    {
      "filter": "datum.rank<=15"
    },
    {
      "calculate": "width<260 ? replace(datum.route_id,'-','\u2013') : replace(datum.route_name,' - ',' \u2013 ')",
      "as": "label"
    },
    {
      "calculate": "abs(datum.change_points)<0.05 ? '0.0' : (datum.change_points>0 ? '+' : '\u2212')+format(abs(datum.change_points),'.1f')",
      "as": "change_label"
    },
    {
      "calculate": "format(datum.occupancy_2026_pct,'.1f')+'%  ('+datum.change_label+' pts)'",
      "as": "value_label"
    },
    {
      "calculate": "format(datum.occupancy_2019_pct,'.1f')+'% of seats filled'",
      "as": "tip_2019"
    },
    {
      "calculate": "format(datum.occupancy_2026_pct,'.1f')+'% of seats filled'",
      "as": "tip_2026"
    },
    {
      "calculate": "datum.change_label+' percentage points'",
      "as": "tip_change"
    },
    {
      "calculate": "max(datum.occupancy_2019_pct, datum.occupancy_2026_pct)",
      "as": "right_end"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "rank",
            "op": "min",
            "order": "ascending"
          },
          "axis": {
            "title": null,
            "labelFontSize": {
              "expr": "width<550 ? 11 : 12"
            },
            "labelLimit": 220,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "occupancy_2019_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              65,
              106
            ],
            "nice": false
          },
          "axis": {
            "title": "Share of seats filled over the year (%)",
            "values": [
              65,
              70,
              75,
              80,
              85,
              90,
              95
            ],
            "grid": true
          }
        },
        "x2": {
          "field": "occupancy_2026_pct"
        },
        "color": {
          "condition": [
            {
              "test": "abs(datum.change_points)<0.05",
              "value": "#506365"
            },
            {
              "test": "datum.change_points>0",
              "value": "#316EAC"
            }
          ],
          "value": "#B55732"
        },
        "opacity": {
          "value": 0.55
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "occupancy_2019_pct",
            "occupancy_2026_pct"
          ],
          "as": [
            "year",
            "occupancy"
          ]
        },
        {
          "calculate": "datum.year==='occupancy_2019_pct' ? '2018\u201319' : '2025\u201326'",
          "as": "year"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 90,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "rank",
            "op": "min",
            "order": "ascending"
          },
          "axis": {
            "title": null,
            "labelFontSize": {
              "expr": "width<550 ? 11 : 12"
            },
            "labelLimit": 220,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "occupancy",
          "type": "quantitative",
          "scale": {
            "domain": [
              65,
              106
            ],
            "nice": false
          },
          "axis": {
            "title": "Share of seats filled over the year (%)",
            "values": [
              65,
              70,
              75,
              80,
              85,
              90,
              95
            ],
            "grid": true
          }
        },
        "tooltip": [
          {
            "field": "route_name",
            "type": "nominal",
            "title": "Route"
          },
          {
            "field": "tip_2019",
            "type": "nominal",
            "title": "2018\u201319"
          },
          {
            "field": "tip_2026",
            "type": "nominal",
            "title": "2025\u201326"
          },
          {
            "field": "tip_change",
            "type": "nominal",
            "title": "Change"
          },
          {
            "field": "latest_trips",
            "type": "quantitative",
            "title": "Passenger trips, 2025\u201326",
            "format": ",.0f"
          }
        ],
        "color": {
          "field": "year",
          "type": "nominal",
          "scale": {
            "domain": [
              "2018\u201319",
              "2025\u201326"
            ],
            "range": [
              "#AEBBBA",
              "#243637"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "lineHeight": 15,
        "color": "#243637",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "rank",
            "op": "min",
            "order": "ascending"
          },
          "axis": {
            "title": null,
            "labelFontSize": {
              "expr": "width<550 ? 11 : 12"
            },
            "labelLimit": 220,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "right_end",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label",
          "type": "nominal"
        },
        "color": {
          "condition": [
            {
              "test": "abs(datum.change_points)<0.05",
              "value": "#506365"
            },
            {
              "test": "datum.change_points>0",
              "value": "#316EAC"
            }
          ],
          "value": "#B55732"
        }
      }
    }
  ],
  "usermeta": {
    "chart_id": 14,
    "source": "Supplied BITRE workbook; FY2018-19 and FY2025-26"
  }
}
