            "field": "passenger_trips",
            "type": "quantitative",
            "title": "Passenger trips",
            "format": ",.0f"
          },
          {
            "field": "population",
            "type": "quantitative",
            "title": "Residents at 31 December",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_ending===2026"
        },
        {
          "calculate": "(width<550 ? (datum.measure==='Passenger trips' ? 'Trips' : 'People') : datum.measure)+'  '+format(datum.index,'.1f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "lineHeight": 15,
        "color": "#243637",
        "fontWeight": "bold",
        "align": "left",
        "baseline": "middle",
