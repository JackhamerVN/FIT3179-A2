            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "measure",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "index",
            "type": "quantitative",
            "title": "Index (2018-19 = 100)",
            "format": ".1f"
          },
