{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Rank of the 15 busiest airports by domestic passenger movements, FY2014-15 to FY2025-26.",
  "width": "container",
  "height": 430,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 8,
  "background": "transparent",
  "config": {
    "font": "B612, Arial, Helvetica, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#506365",
      "titleColor": "#506365",
      "gridColor": "#DFE6E5",
      "gridOpacity": 0.7,
      "domain": false,
      "tickColor": "#BCCAC8",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "orient": "bottom"
    }
  },
  "data": {
    "url": "data/airport-ranks.json"
  },
  "params": [
    {
      "name": "compactLabels",
      "expr": "width<550"
    }
  ],
  "transform": [
    {
      "calculate": "(compactLabels ? datum.airport_id : datum.airport)+(datum.places_gained>0 ? '  +'+datum.places_gained : datum.places_gained<0 ? '  \u2212'+abs(datum.places_gained) : '')",
      "as": "label"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "start": "2019-20",
            "end": "2021-22"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#E4ECEA",
        "opacity": 0.75
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "14"
              },
              {
                "expr": "width-(compactLabels ? 58 : 132)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
            "labelAngle": 0,
            "labelOverlap": "parity",
            "grid": false,
            "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
          }
        },
        "x2": {
          "field": "end"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "fy": "2020-21",
            "note": [
              "Travel bans",
              "and lockdowns"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11,
        "lineHeight": 13,
        "color": "#506365"
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "14"
              },
              {
                "expr": "width-(compactLabels ? 58 : 132)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
            "labelAngle": 0,
            "labelOverlap": "parity",
            "grid": false,
            "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
          }
        },
        "y": {
          "datum": -0.45
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "14"
              },
              {
                "expr": "width-(compactLabels ? 58 : 132)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
            "labelAngle": 0,
            "labelOverlap": "parity",
            "grid": false,
            "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.2,
              16.6
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Rank",
            "values": [
              1,
              5,
              10,
              15
            ],
            "grid": false
          }
        },
        "detail": {
          "field": "airport_id",
          "type": "nominal"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "up",
              "same",
              "down"
            ],
            "range": [
              "#316EAC",
              "#93A3A1",
              "#B55732"
            ]
          },
          "legend": {
            "title": "Change since 2014\u201315",
            "labelExpr": "datum.label==='up' ? 'Up' : datum.label==='down' ? 'Down' : 'Same'"
          }
        },
        "opacity": {
          "condition": {
            "param": "pickedAirport",
            "empty": true,
            "value": 1
          },
          "value": 0.14
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.airport_id==='MCY'",
            "value": 5
          },
          "value": 2.4
        }
      }
    },
    {
      "name": "rankTargets",
      "params": [
        {
          "name": "pickedAirport",
          "select": {
            "type": "point",
            "fields": [
              "airport_id"
            ],
            "on": "click",
            "clear": "dblclick"
          },
          "bind": {
            "input": "select",
            "options": [
              null,
              "ADL",
              "BNE",
              "CNS",
              "CBR",
              "DRW",
              "OOL",
              "HBA",
              "LST",
              "MKY",
              "MEL",
              "NTL",
              "PER",
              "MCY",
              "SYD",
              "TSV"
            ],
            "labels": [
              "All 15 airports",
              "Adelaide (ADL)",
              "Brisbane (BNE)",
              "Cairns (CNS)",
              "Canberra (CBR)",
              "Darwin (DRW)",
              "Gold Coast (OOL)",
              "Hobart (HBA)",
              "Launceston (LST)",
              "Mackay (MKY)",
              "Melbourne (MEL)",
              "Newcastle (NTL)",
              "Perth (PER)",
              "Sunshine Coast (MCY)",
              "Sydney (SYD)",
              "Townsville (TSV)"
            ],
            "name": "Highlight an airport "
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 12,
        "opacity": 0,
        "interpolate": "monotone",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "14"
              },
              {
                "expr": "width-(compactLabels ? 58 : 132)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
            "labelAngle": 0,
            "labelOverlap": "parity",
            "grid": false,
            "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.2,
              16.6
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Rank",
            "values": [
              1,
              5,
              10,
              15
            ],
            "grid": false
          }
        },
        "detail": {
          "field": "airport_id",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "airport",
            "type": "nominal",
            "title": "Airport"
          }
        ]
      }
    },
    {
      "name": "rankDots",
      "mark": {
        "type": "circle",
        "size": 62,
        "stroke": "white",
        "strokeWidth": 1.2,
        "opacity": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "14"
              },
              {
                "expr": "width-(compactLabels ? 58 : 132)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
            "labelAngle": 0,
            "labelOverlap": "parity",
            "grid": false,
            "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.2,
              16.6
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Rank",
            "values": [
              1,
              5,
              10,
              15
            ],
            "grid": false
          }
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "up",
              "same",
              "down"
            ],
            "range": [
              "#316EAC",
              "#93A3A1",
              "#B55732"
            ]
          },
          "legend": {
            "title": "Change since 2014\u201315",
            "labelExpr": "datum.label==='up' ? 'Up' : datum.label==='down' ? 'Down' : 'Same'"
          }
        },
        "opacity": {
          "condition": {
            "param": "pickedAirport",
            "empty": true,
            "value": 1
          },
          "value": 0.14
        },
        "tooltip": [
          {
            "field": "airport",
            "type": "nominal",
            "title": "Airport"
          },
          {
            "field": "fy",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "passenger_movements",
            "type": "quantitative",
            "title": "Passenger movements",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_ending===2026"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 11.5,
        "color": "#243637",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "fy",
          "type": "ordinal",
          "scale": {
            "type": "point",
            "domain": [
              "2014-15",
              "2015-16",
              "2016-17",
              "2017-18",
              "2018-19",
              "2019-20",
              "2020-21",
              "2021-22",
              "2022-23",
              "2023-24",
              "2024-25",
              "2025-26"
            ],
            "range": [
              {
                "expr": "14"
              },
              {
                "expr": "width-(compactLabels ? 58 : 132)"
              }
            ]
          },
          "axis": {
            "title": "Financial year",
            "labelAngle": 0,
            "labelOverlap": "parity",
            "grid": false,
            "labelExpr": "slice(datum.value,2,4)+'\u2013'+slice(datum.value,5)"
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.2,
              16.6
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Rank",
            "values": [
              1,
              5,
              10,
              15
            ],
            "grid": false
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "pickedAirport",
            "empty": true,
            "value": 1
          },
          "value": 0.14
        }
      }
    }
  ],
  "usermeta": {
    "chart_id": 13,
    "source": "BITRE Airport traffic data; FY2014-15 to FY2025-26"
  }
}
