{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Educational Advantage Across Australia",
    "subtitle": "Average ICSEA Score by Statistical Area (SA2)",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "font": "Arial",
    "anchor": "start",
    "color": "#1a1a1a",
    "subtitleColor": "#666666",
    "offset": 10
  },
  "width": 1000,
  "height": 650,
  "projection": {
    "type": "mercator",
    "center": [133, -28],
    "scale": 900
  },
  "layer": [
    {
      "name": "background",
      "data": {
        "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/SA2.json",
        "format": {"type": "topojson", "feature": "SA2"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e8e8",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "name": "choropleth",
      "data": {
        "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/School%20Location%202024.csv"
      },
      "transform": [
        {
          "lookup": "ACARA SML ID",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/School%20Merged%20Full%202024.csv"
            },
            "key": "ACARA SML ID",
            "fields": ["ICSEA"]
          }
        },
        {"filter": "datum.ICSEA != null"},
        {"calculate": "toNumber(datum.ICSEA)", "as": "ICSEA_num"},
        {"filter": "isValid(datum.ICSEA_num) && datum.ICSEA_num > 0"},
        {"calculate": "toString(datum['Statistical Area 2'])", "as": "SA2_str"},
        {
          "aggregate": [
            {"op": "mean", "field": "ICSEA_num", "as": "avg_ICSEA"},
            {"op": "count", "as": "school_count"}
          ],
          "groupby": ["SA2_str"]
        },
        {
          "lookup": "SA2_str",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/SA2.json",
              "format": {"type": "topojson", "feature": "SA2"}
            },
            "key": "properties.sa2_code_2021",
            "fields": ["type", "properties", "geometry"]
          },
          "as": ["geo_type", "geo_properties", "geo_geometry"]
        },
        {"filter": "datum.geo_geometry != null"},
        {
          "calculate": "{'type': datum.geo_type, 'properties': datum.geo_properties, 'geometry': datum.geo_geometry}",
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "avg_ICSEA",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [800, 1200]
          },
          "legend": {
            "title": "Average ICSEA Score",
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 300,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "geo_properties.sa2_name_2021", "type": "nominal", "title": "Region"},
          {"field": "avg_ICSEA", "type": "quantitative", "title": "Average ICSEA", "format": ".1f"},
          {"field": "school_count", "type": "quantitative", "title": "Number of Schools"}
        ]
      }
    },
    {
      "name": "state_borders",
      "data": {
        "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/STE_2021_AUST_SHP_GDA2020.json",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#333333",
        "strokeWidth": 1.5
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#fafafa"
  }
}