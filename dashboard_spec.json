{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "view": {
      "stroke": null,
      "continuousWidth": 500,
      "continuousHeight": 420
    },
    "axis": {
      "grid": true,
      "gridOpacity": 0.3,
      "gridColor": "#e0e0e0",
      "domainWidth": 1.5,
      "domainColor": "#666",
      "labelFont": "'Inter', system-ui, sans-serif",
      "titleFont": "'Inter', system-ui, sans-serif",
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "labelFontSize": 11,
      "labelColor": "#495057",
      "titlePadding": 15
    },
    "title": {
      "font": "'Inter', system-ui, sans-serif",
      "fontSize": 18,
      "fontWeight": "600",
      "anchor": "middle",
      "color": "#343a40",
      "offset": 20,
      "subtitleFont": "'Inter', system-ui, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#6c757d"
    },
    "legend": {
      "titleFont": "'Inter', system-ui, sans-serif",
      "labelFont": "'Inter', system-ui, sans-serif",
      "titleFontSize": 12,
      "labelFontSize": 11,
      "titleFontWeight": 600,
      "symbolSize": 100,
      "padding": 10,
      "cornerRadius": 4
    }
  },
  "params": [
    {
      "name": "state_filter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
        "labels": [
          "All States",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "name": "Select State: "
      }
    },
    {
      "name": "sa2_name_filter",
      "value": "All",
      "bind": {
        "input": "text",
        "placeholder": "Enter suburb/region name (e.g. Clayton, Sandy Bay) or 'All'",
        "name": "Filter by Suburb/Region: "
      }
    }
  ],
  "spacing": 30,
  "hconcat": [
    {
      "width": 500,
      "height": 420,
      "title": {
        "text": "Resources by School Type",
        "subtitle": "Average Student-Teacher Ratio across Australia"
      },
      "data": {
        "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/School%20Location%202024.csv"
      },
      "transform": [
        {
          "filter": "state_filter == 'All' || datum.State == state_filter"
        },
        {
          "filter": "sa2_name_filter == 'All' || indexof(lower(datum['Statistical Area 2 Name']), lower(sa2_name_filter)) >= 0"
        },
        {
          "lookup": "ACARA SML ID",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/School%20Merged%20Full%202024.csv"
            },
            "key": "ACARA SML ID",
            "fields": [
              "School Sector",
              "Full Time Equivalent Enrolments",
              "Full Time Equivalent Teaching Staff"
            ]
          }
        },
        {
          "filter": "datum['Full Time Equivalent Teaching Staff'] != null && datum['Full Time Equivalent Teaching Staff'] > 0"
        },
        {
          "calculate": "datum['Full Time Equivalent Enrolments'] / datum['Full Time Equivalent Teaching Staff']",
          "as": "StudentTeacherRatio"
        },
        {
          "aggregate": [
            {"op": "mean", "field": "StudentTeacherRatio", "as": "avg_STR"}
          ],
          "groupby": ["School Sector"]
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 6,
        "opacity": 0.9,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "School Sector",
          "type": "nominal",
          "title": "School Type",
          "axis": {"labelAngle": 0}
        },
        "y": {
          "field": "avg_STR",
          "type": "quantitative",
          "title": "Average Student-Teacher Ratio",
          "scale": {"domain": [0, 20]}
        },
        "color": {
          "field": "School Sector",
          "type": "nominal",
          "scale": {
            "domain": ["Government", "Catholic", "Independent"],
            "range": ["#4e79a7", "#f28e2c", "#e15759"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "School Sector", "type": "nominal", "title": "School Type"},
          {"field": "avg_STR", "type": "quantitative", "title": "Avg Student-Teacher Ratio", "format": ".2f"}
        ]
      }
    },
    {
      "width": 500,
      "height": 420,
      "title": {
        "text": "School Density: Advantage vs. Demographics",
        "subtitle": "Distribution of schools by ICSEA and Indigenous enrollment"
      },
      "data": {
        "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/School%20Location%202024.csv"
      },
      "transform": [
        {
          "filter": "state_filter == 'All' || datum.State == state_filter"
        },
        {
          "filter": "sa2_name_filter == 'All' || indexof(lower(datum['Statistical Area 2 Name']), lower(sa2_name_filter)) >= 0"
        },
        {
          "lookup": "ACARA SML ID",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/JackhamerVN/FIT3179-A2/main/School%20Merged%20Full%202024.csv"
            },
            "key": "ACARA SML ID",
            "fields": [
              "ICSEA",
              "Indigenous Enrolments (%)",
              "School Sector"
            ]
          }
        },
        {
          "filter": "datum.ICSEA != null && datum['Indigenous Enrolments (%)'] != null"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 0.5,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "bin": {"maxbins": 20},
          "field": "ICSEA",
          "type": "quantitative",
          "title": "ICSEA Score (Socio-Economic Advantage)"
        },
        "y": {
          "bin": {"maxbins": 20},
          "field": "Indigenous Enrolments (%)",
          "type": "quantitative",
          "title": "Indigenous Enrolment (%)"
        },
        "color": {
          "aggregate": "count",
          "type": "quantitative",
          "scale": {
            "scheme": "viridis"
          },
          "legend": {
            "title": "Number of Schools",
            "orient": "bottom",
            "gradientLength": 200
          }
        },
        "tooltip": [
          {
            "bin": {"maxbins": 20},
            "field": "ICSEA",
            "type": "quantitative",
            "title": "ICSEA Range"
          },
          {
            "bin": {"maxbins": 20},
            "field": "Indigenous Enrolments (%)",
            "type": "quantitative",
            "title": "Indigenous % Range"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Number of Schools"
          }
        ]
      }
    }
  ]
}
